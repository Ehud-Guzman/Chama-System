PORT=5000
MONGO_URI=
JWT_SECRET=
# How long a signed-in session lasts. 8h suits a full working day; 2h–4h is a better
# fit for an office account signed in on a shared phone. Changing a password ends
# every other session immediately (see middleware/auth.js), so this is a ceiling and
# not a promise.
JWT_EXPIRES_IN=8h
NODE_ENV=development
# Allowed CORS origins — one, or several separated by commas. In production list the
# live domain, its www twin and the site's own netlify.app address, e.g.
#   FRONTEND_URL=https://wazomojashg.co.ke,https://www.wazomojashg.co.ke,https://<site>.netlify.app
# Trailing slashes are ignored, and a request with no Origin header at all (curl, a
# health check, a browser navigation) is always allowed.
FRONTEND_URL=http://localhost:5173
LOOKUP_RATE_LIMIT_WINDOW_MS=60000
LOOKUP_RATE_LIMIT_MAX=5
# Sign-in budget, applied twice: per client address *and* per email address (5
# attempts each), so an office behind a shared connection is not locked out by
# strangers, and a script working through a list of addresses still runs out.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_SPRAY_LIMIT_MAX=30
# The second factor. Ten code attempts per challenge (a six-digit code is a million
# possibilities and the code changes every 30 seconds), and the spray budget above
# caps total attempts from one connection.
TWO_FACTOR_RATE_LIMIT_MAX=10
# Authenticated API: requests per minute per session. 300 is generous for a desk
# that is being used; it exists to stop a runaway retry loop, not people.
API_RATE_LIMIT_MAX=300
# Log level. Every request leaves one JSON line on stdout; set this to "silent" in
# a local shell if that is noise. (The test suite sets it itself.)
LOG_LEVEL=

# Cloudinary — member profile photos.
# Either a single CLOUDINARY_URL (cloudinary://key:secret@cloud-name) or the three
# values below. Without them the photo picker reports that uploads aren't set up.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional — where member photos are stored inside the Cloudinary account
CLOUDINARY_FOLDER=chama-system/members
# Optional — where the group's logo is kept, deliberately outside the members' folder
CLOUDINARY_BRANDING_FOLDER=chama-system/branding

# SMTP — late-contribution and fine reminder emails.
# Without a mail configuration the reminders page explains that sending isn't set up
# yet; nothing else in the app is affected. The values being present is not the same as
# the host being able to reach the provider, so the first batch sent after a change is
# the check — it proves the connection before it emails anybody.
# SMTP_HOST is resolved to IPv4 here, before nodemailer sees it: some hosts (Render)
# carry an IPv6 interface with no IPv6 route, and nodemailer chooses a family at random.
# Note that Render's *Free* instances cannot send outbound traffic on ports 25, 465 or
# 587 at all, so Gmail's SMTP can never work from one: a provider that listens on port
# 2525 (Brevo, Mailgun, Mailjet, Postmark, SendGrid) does, with no other change.
SMTP_HOST=
SMTP_PORT=587
# Leave blank for a provider that needs no authentication
SMTP_USER=
SMTP_PASS=
# "true" forces implicit TLS; defaults to true only on port 465
SMTP_SECURE=
# Must be an address the SMTP provider allows you to send as
MAIL_FROM=
# Optional — where replies should go (e.g. the treasurer's own inbox)
MAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# Sending through a mail API over HTTPS — the road a blocked host cannot close
# -----------------------------------------------------------------------------
# Same providers, over port 443 instead of 587. This matters on a host that refuses outbound
# SMTP: Render's Free instances cannot send on 25, 465 or 587 at all, so on one of those this
# is what makes the reminders button work. A key here wins over SMTP_HOST above, and the key
# itself is checked before every batch sends.
#   MAIL_API_PROVIDER  brevo | resend | sendgrid
#   MAIL_API_KEY       the provider's own API key
#                      (Brevo: Settings -> SMTP & API -> API keys; Resend: API Keys;
#                       SendGrid: Settings -> API Keys)
# MAIL_FROM must be a sender the provider has verified.
MAIL_API_PROVIDER=
MAIL_API_KEY=

# -----------------------------------------------------------------------------
# Scheduled jobs — the things nobody has to remember
# -----------------------------------------------------------------------------
# "false" switches the whole timer off. On a host that runs more than one instance this is
# still safe: a lease in the database means only one instance actually runs each job (see
# models/JobLock). Set it to "false" on a second instance if you would rather it did not try.
JOBS_ENABLED=true

# When each job runs, in East African time. Format:
#   daily@HH:MM · weekly@<weekday>@HH:MM · monthly@<day>@HH:MM
# Defaults: the backup nightly at 02:00, the audit check Saturdays at 04:00, the reminder
# sweep Sundays at 18:00.
JOB_BACKUP_SCHEDULE=daily@02:00
JOB_AUDIT_SCHEDULE=weekly@sat@04:00
JOB_REMINDER_SCHEDULE=weekly@sun@18:00

# Where the nightly backup is written. The default is backend/data/backups, which is gitignored
# and — on a host with an ephemeral disk (Render, Railway) — does NOT survive a deploy. Point
# this at a mounted volume, or copy it off the host: a backup that lives only on the machine it
# is backing up is not a backup.
BACKUP_DIR=
# How many backup files to keep before the oldest are removed. Default 14.
BACKUP_RETENTION=14

# Audit trail retention, in days. Blank or 0 keeps everything, which is the default: the trail
# is the group's history, and deleting it is a decision for the committee, not a deploy. Only
# entries written before the hash chain existed are ever pruned automatically.
AUDIT_RETENTION_DAYS=

# Where the weekly audit check emails the chain's head. That emailed value is the anchor that
# catches entries removed from the end of the trail — the one thing the chain cannot see by
# itself. Defaults to MAIL_REPLY_TO, then MAIL_FROM.
AUDIT_HEAD_EMAIL=

# Whether the weekly reminder sweep actually emails members who are behind. Off by default and
# deliberately so: a deploy must never start emailing the membership on its own. The sweep
# always works out who is behind and reports it either way.
REMINDER_SWEEP_SEND=false
# The most members one sweep will email. Default 200.
REMINDER_SWEEP_MAX=200

# Whether a fine emails the member on its own: one message as the fine is recorded, one when money
# clears it (a settlement, or a contribution that pays it down when autoSettleFines is on). ON by
# default — unlike the sweep above, both are triggered by somebody recording or settling a fine,
# not by a schedule. Set to off on a deployment whose committee does not want them. Either way
# nothing is sent without a mail configuration, and a member with no address or with email
# reminders switched off is skipped, with the reason written to the request log.
FINE_EMAILS=

# Which account automatic writes are credited to in the audit trail (a nightly backup, a sweep).
# Defaults to the earliest super admin.
SYSTEM_ACTOR_EMAIL=
