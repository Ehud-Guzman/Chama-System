node_modules/
dist/
.env
.env.local
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Docker build context and the Compose database volume, if somebody ends up with a stray directory
# from an older Compose file. The named volumes in docker-compose.yml live outside the tree.
backend/data/db/
.mongo/

# These two migration scripts embedded real member names, phone numbers and
# amounts, so a tracked copy would hand out the key to the members area — a phone
# number is the credential for the gated documents and minutes. Both have been
# removed from the repo and archived outside it. The rules stay as a guard so a
# copy restored from that archive can never be committed by accident.
#
# NOTE: removing a file from HEAD does not remove it from history. These two are
# still reachable in old commits — see the "Member data in this repository"
# section of the README for the purge that is required, and for why the repository
# must stay private until it has run.
backend/src/scripts/importHarambeeContributions.js
backend/src/scripts/findWrongAmounts.js

# A reset/backup dump carries the same material — every member's name, phone
# number and balance — so it never gets committed either.
backend/data/reset-backup-*.json
# The same holds for the copy `npm run balances:restore` takes before it writes.
backend/data/opening-balances-*.json
# ...and for the row-level copy the clearing scripts take.
backend/data/contributions-cleared-*.json

# Any spreadsheet or export under backend/ is member data, whatever it is called.
# The rules above were too narrow once: a file named `ledger_weeks_62_84_template.xlsx`
# and another named `test.xlsx` both carried real names and amounts, and neither
# matched a pattern, so both were committed. A "template" from the office is not a
# template until somebody has emptied it.
backend/data/
backend/*.xlsx
backend/*.xls
backend/*.csv

