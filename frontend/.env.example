# Where the API lives. Vite reads this while building, so on Netlify it belongs in
# Site configuration → Environment variables, and changing it needs a redeploy
# (Deploys → Trigger deploy → Clear cache and deploy site).
#
# Local development — copy this file to .env.local and leave it as it is:
#   VITE_API_URL=http://localhost:5000
#
# Production — the API's own address, e.g.:
#   VITE_API_URL=https://api.wazomojashg.co.ke
#
# Left unset the app falls back to http://localhost:5000, which is only ever right
# on a developer's machine.
VITE_API_URL=http://localhost:5000
